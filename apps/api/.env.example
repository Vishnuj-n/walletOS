# TRANSACTION POOLER (Port 6543) - Use for the running app
# Append pgbouncer=true to prevent "prepared statement already exists" errors
DATABASE_URL="postgresql://user:password@localhost:6543/postgres?pgbouncer=true&connection_limit=1"

# SESSION/DIRECT CONNECTION (Port 5432) - Use ONLY for Prisma Migrations
# This allows Prisma to manage schema changes without pooler interference
DIRECT_URL="postgresql://user:password@localhost:5432/postgres"

# Environment
NODE_ENV="development"
