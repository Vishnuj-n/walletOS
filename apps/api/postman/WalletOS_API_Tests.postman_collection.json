        {
          "name": "API Key Scope Tests",
          "item": [
            {
              "name": "Read-Only: Get Wallet (Succeed)",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "x-api-key",
                    "value": "{{readOnlyApiKey}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/v1/wallets/{{walletId}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v1", "wallets", "{{walletId}}"]
                },
                "description": "Read-only key should be allowed to view wallet"
              },
              "response": []
            },
            {
              "name": "Read-Only: Try Create Wallet (Fail 403)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "x-api-key",
                    "value": "{{readOnlyApiKey}}"
                  },
                  {
                    "key": "Idempotency-Key",
                    "value": "ro_create_{{$timestamp}}"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"external_user_id\": \"ro_failed_{{$timestamp}}\",\n  \"currency\": \"INR\",\n  \"label\": \"Should Fail\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/v1/wallets",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v1", "wallets"]
                },
                "description": "Read-only key should be blocked from write operations (POST)"
              },
              "response": []
            },
            {
              "name": "Read-Write: Create Wallet (Succeed)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "x-api-key",
                    "value": "{{readWriteApiKey}}"
                  },
                  {
                    "key": "Idempotency-Key",
                    "value": "rw_create_{{$timestamp}}"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"external_user_id\": \"rw_success_{{$timestamp}}\",\n  \"currency\": \"INR\",\n  \"label\": \"RW Created Wallet\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/v1/wallets",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v1", "wallets"]
                },
                "description": "Read-write key should be allowed to create wallets (POST)"
              },
              "response": []
            },
            {
              "name": "Read-Write: Try Delete Wallet (Fail 403)",
              "request": {
                "method": "DELETE",
                "header": [
                  {
                    "key": "x-api-key",
                    "value": "{{readWriteApiKey}}"
                  },
                  {
                    "key": "Idempotency-Key",
                    "value": "rw_delete_{{$timestamp}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/v1/wallets/{{walletId}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v1", "wallets", "{{walletId}}"]
                },
                "description": "Read-write key should be blocked from delete operations (DELETE)"
              },
              "response": []
            }
          ]
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Create Session Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}"
              }
            ],
