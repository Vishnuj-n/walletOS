        {
          "name": "Frozen Wallet Test",
          "item": [
            {
              "name": "Freeze Wallet",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "x-api-key",
                    "value": "{{apiKey}}"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"reason\": \"Test freeze\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/v1/wallets/{{walletId}}/freeze",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v1", "wallets", "{{walletId}}", "freeze"]
                }
              },
              "response": []
            },
            {
              "name": "Try Credit to Frozen Wallet (Should Fail)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "x-api-key",
                    "value": "{{apiKey}}"
                  },
                  {
                    "key": "Idempotency-Key",
                    "value": "frozen_test_{{$timestamp}}"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"wallet_id\": \"{{walletId}}\",\n  \"amount\": 100,\n  \"description\": \"Test credit\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/v1/transactions/credit",
                  "host": ["{{baseUrl}}"],
