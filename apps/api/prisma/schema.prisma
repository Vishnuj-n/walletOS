generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id           String        @id @default(cuid())
  name         String
  contactEmail String?
  config       Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  adminUsers   AdminUser[]
  apiKeys      ApiKey[]
  auditLogs    AuditLog[]
  transactions Transaction[]
  wallets      Wallet[]
  webhooks     Webhook[]
}

model ApiKey {
  id        String   @id @default(cuid())
  tenantId  String
  keyHash   String   @unique
  prefix    String
  scope     KeyScope
  isSandbox Boolean  @default(false)
  isActive  Boolean  @default(true)
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model AdminUser {
  id          String    @id @default(cuid())
  tenantId    String
  supabaseUid String
  email       String
  role        AdminRole
  isActive    Boolean   @default(true)
  tenant      Tenant    @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, supabaseUid])
  @@index([tenantId])
}

model Wallet {
  id                 String        @id @default(cuid())
  tenantId           String
  externalUserId     String
  label              String?
  balance            Decimal       @default(0) @db.Decimal(20, 4)
  currency           String        @default("USD")
  status             WalletStatus  @default(active)
  isSandbox          Boolean       @default(false)
  metadata           Json?
  closureScheduledAt DateTime?
  transactions       Transaction[]
  tenant             Tenant        @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, externalUserId, isSandbox])
  @@index([tenantId])
  @@index([externalUserId])
}

model Transaction {
  id             String          @id @default(cuid())
  tenantId       String
  walletId       String
  type           TransactionType
  amount         Decimal         @db.Decimal(20, 4)
  currency       String
  balanceBefore  Decimal         @db.Decimal(20, 4)
  balanceAfter   Decimal         @db.Decimal(20, 4)
  referenceId    String?
  idempotencyKey String?
  metadata       Json?
  createdAt      DateTime        @default(now())
  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  wallet         Wallet          @relation(fields: [walletId], references: [id])

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId])
  @@index([walletId])
  @@index([referenceId])
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  entityType String
  entityId   String
  action     String
  changes    Json?
  actorId    String?
  actorType  String?
  timestamp  DateTime @default(now())
  isSandbox  Boolean  @default(false)
  tenant     Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([entityType, entityId])
  @@index([timestamp])
  @@index([isSandbox])
}

model Webhook {
  id           String          @id @default(cuid())
  tenantId     String
  url          String
  events       String[]
  secret       String
  isActive     Boolean         @default(true)
  lastAttempt  DateTime?
  failureCount Int             @default(0)
  status       String          @default("active")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  tenant       Tenant          @relation(fields: [tenantId], references: [id])
  deliveries   WebhookDelivery[]

  @@index([tenantId])
}

model WebhookDelivery {
  id          String    @id @default(cuid())
  webhookId   String
  webhook     Webhook   @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  eventType   String
  payload     Json
  statusCode  Int?
  response    String?
  attemptNum  Int
  nextAttempt DateTime?
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([webhookId])
  @@index([nextAttempt])
}

model SessionToken {
  id        String   @id @default(cuid())
  tenantId  String
  tokenHash String
  scope     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([tokenHash])
}

enum KeyScope {
  read_only
  read_write
  admin
}

enum AdminRole {
  support
  finance
  superadmin
}

enum WalletStatus {
  active
  frozen
  pending_closure
  closed
}

enum TransactionType {
  credit
  debit
  reversal
}
