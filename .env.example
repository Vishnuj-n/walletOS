# Environment Configuration Template
# WalletOS uses 2 .env files with different database setups:
# - .env: Direct Supabase connection for development/production
# - .env.test: Local Docker database + remote Supabase auth for testing

# ============================================
# SUPABASE REMOTE DATABASE CONNECTION
# ============================================
# Get these from your Supabase project settings:
# 1. Go to https://supabase.com/dashboard/project/[YOUR-PROJECT-ID]/settings/database
# 2. Copy the Connection String (Transaction Pooler) for DATABASE_URL
# 3. Copy the Connection String (Direct) for DIRECT_URL

# Transaction Pooler (Port 6543) - Use for running application
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true&sslmode=require"

# Direct Connection (Port 5432) - Use ONLY for Prisma Migrations
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# ============================================
# SUPABASE AUTHENTICATION
# ============================================
# Get these from https://supabase.com/dashboard/project/[YOUR-PROJECT-ID]/settings/api
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SERVICE-ROLE-KEY]"

# ============================================
# ADMIN DASHBOARD (Client-Side)
# ============================================
# Get these from https://supabase.com/dashboard/project/[YOUR-PROJECT-ID]/settings/api
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR-ANON-KEY]"
NEXT_PUBLIC_API_URL="http://localhost:3333/api/v1"

# ============================================
# DEMO API CONFIGURATION
# ============================================
# API key for demo session generation (hardcoded demo wallet only)
WALLETOS_DEMO_API_KEY="[YOUR-DEMO-API-KEY]"
WALLETOS_DEMO_WALLET_ID="[YOUR-DEMO-WALLET-ID]"

# ============================================
# ENVIRONMENT
# ============================================
# Set to "development" for .env file
# Set to "test" for .env.test file
NODE_ENV="development"


