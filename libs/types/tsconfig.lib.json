{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "rootDir": "./src",
    "declaration": true,
    "module": "Node16",
    "ignoreDeprecations": "5.0",
    "types": ["node"]
  },
  "composite": true,
  "include": ["src/**/*.ts"],
  "exclude": [
    "jest.config.ts",
    "jest.config.cts",
    "src/**/*.spec.ts",
    "src/**/*.spec.zts",
    "src/**/*.test.ts"
  ]
}
